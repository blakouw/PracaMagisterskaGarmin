{
  "policy_version": "garmin_activity_normalization_v1",
  "source_modules": {
    "workbook_trimmed_activities": "03_trim_workbook",
    "optional_api_ingest": "04_garmin_activity_ingest"
  },
  "activity_sources_optional": true,
  "normalized_activity_primary_key": "activity_id",
  "date_assignment_field": "start_time_local",
  "normalized_date_field": "date",
  "date_assignment_rule": "extract_local_calendar_date_from_start_time_local",
  "missing_values_policy": "preserve_as_null",
  "duplicate_activity_id_policy": "merge_by_explicit_source_priority_and_report_conflicts",
  "source_priority": [
    "workbook_activities_csv",
    "api_details_json",
    "api_splits_json"
  ],
  "source_role_policy": {
    "workbook_activities_csv": "primary_tabular_activity_source_when_available",
    "api_details_json": "optional_enrichment_and_api_only_record_source_when_core_identity_fields_exist",
    "api_splits_json": "optional_nested_split_enrichment_only",
    "fit_file": "reference_only_do_not_parse",
    "tcx_file": "reference_only_do_not_parse"
  },
  "unit_conversions": {
    "distance": {
      "source_unit": "meters",
      "normalized_field": "distance_km",
      "rule": "divide numeric source value by 1000"
    },
    "average_speed": {
      "source_unit": "meters_per_second",
      "normalized_field": "average_speed_kmh",
      "rule": "multiply numeric source value by 3.6"
    },
    "maximum_speed": {
      "source_unit": "meters_per_second",
      "normalized_field": "maximum_speed_kmh",
      "rule": "multiply numeric source value by 3.6"
    },
    "duration": {
      "source_unit": "seconds",
      "normalized_field": "duration_seconds",
      "rule": "preserve numeric source value as seconds"
    },
    "elevation": {
      "source_unit": "meters",
      "normalized_fields": [
        "elevation_gain_m",
        "elevation_loss_m"
      ],
      "rule": "preserve numeric source values as meters"
    },
    "heart_rate_zones": {
      "source_unit": "seconds_if_provided_by_source",
      "normalized_fields": [
        "hr_zone_1_seconds",
        "hr_zone_2_seconds",
        "hr_zone_3_seconds",
        "hr_zone_4_seconds",
        "hr_zone_5_seconds"
      ],
      "rule": "preserve numeric source values as seconds only when source meaning is explicit"
    }
  },
