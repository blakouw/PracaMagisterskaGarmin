{
  "policy_version": "garmin_daily_normalization_v1",
  "source_module": "03_trim_workbook",
  "primary_sheet": "Daily_Summary",
  "primary_source_date_field": "calendarDate",
  "normalized_date_field": "date",
  "date_format": "YYYY-MM-DD",
  "join_strategy": "left_join_optional_daily_sheets_to_daily_summary_dates",
  "unknown_source_columns_policy": "ignore_and_report",
  "missing_values_policy": "preserve_as_null",
  "duplicate_date_policy": "fail_for_consumed_daily_sheets",
  "orphan_optional_rows_policy": "exclude_and_report",
  "activities_sheet_policy": "exclude_from_this_module",
  "api_activity_artifacts_policy": "exclude_from_this_module",
  "unit_conversions": {
    "body_weight": {
      "normalized_field": "weight_kg",
      "rule": "if numeric source value is greater than 400, treat as grams and divide by 1000; otherwise treat as kilograms"
    }
  },
  "output_fields": [
    "date",
    "active_kcal",
    "steps",
    "resting_hr_bpm",
    "resting_hr_baseline_bpm",
    "resting_hr_avg_bpm",
    "avg_stress",
    "max_stress",
    "sleep_seconds",
    "deep_sleep_seconds",
    "light_sleep_seconds",
    "rem_sleep_seconds",
    "awake_sleep_seconds",
    "hrv_weekly_avg_ms",
    "hrv_last_night_avg_ms",
    "hrv_status",
    "hrv_baseline_balanced_low_ms",
    "hrv_baseline_balanced_upper_ms",
    "avg_spo2",
    "avg_sleep_spo2",
    "lowest_sleep_spo2",
    "lowest_spo2",
    "avg_spo2_7d",
    "avg_sleep_respiration",
    "lowest_respiration",
    "avg_waking_respiration",
    "moderate_minutes",
    "vigorous_minutes",
    "total_intensity_minutes_source",
    "steps_distance_source",
    "steps_goal",
    "weight_kg"
  ],
  "field_definitions": [
