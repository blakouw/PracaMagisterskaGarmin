      "type": "string",
      "nullable": false,
      "source_role": "primary_key",
      "description": "Normalized calendar day sourced from Daily_Summary."
    },
    {
      "name": "active_kcal",
      "type": "number",
      "nullable": false,
      "source_role": "required_source_value",
      "description": "Active kilocalories from Daily_Summary; no load metric is calculated in this module."
    },
    {
      "name": "steps",
      "type": "number",
      "nullable": true,
      "source_role": "optional_source_value",
      "description": "Daily steps from configured source priority."
    },
    {
      "name": "resting_hr_bpm",
      "type": "number",
      "nullable": true,
      "source_role": "optional_source_value",
      "description": "Resting heart rate from configured source priority."
    },
    {
      "name": "resting_hr_baseline_bpm",
      "type": "number",
      "nullable": true,
      "source_role": "optional_source_value",
      "description": "Resting heart rate baseline/source average when available."
    },
    {
      "name": "resting_hr_avg_bpm",
      "type": "number",
      "nullable": true,
      "source_role": "optional_source_value",
      "description": "Resting heart rate source average when available."
