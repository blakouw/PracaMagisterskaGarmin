    },
    {
      "name": "sleep_seconds",
      "type": "number",
      "nullable": true,
      "source_role": "optional_source_value",
      "description": "Source sleep duration in seconds."
    },
    {
      "name": "deep_sleep_seconds",
      "type": "number",
      "nullable": true,
      "source_role": "optional_source_value",
