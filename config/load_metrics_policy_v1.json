{
  "policy_version": "load_metrics_policy_v1",
  "source_module": "07_build_daily_features",
  "optional_activity_source_module": "06_normalize_activities",
  "daily_load_source_field": "session_rpe_with_active_kcal_fallback",
  "daily_load_normalized_field": "load_value",
  "daily_load_reference_field": "load_active_kcal",
  "daily_load_interpretation": "session_rpe_preferred_with_explicit_active_kcal_fallback",
  "daily_load_selection_policy": {
    "preferred_source": "session_rpe",
    "fallback_source": "active_kcal",
    "preferred_source_condition": "at_least_one_activity_and_every_activity_has_valid_rpe_and_positive_duration",
    "partial_rpe_day_policy": "fallback_entire_day_to_active_kcal_without_mixing_sources_inside_the_day",
    "no_activity_day_policy": "use_active_kcal_fallback",
    "missing_activity_artifact_policy": "use_active_kcal_fallback_and_report_source_availability"
  },
  "session_rpe_policy": {
    "rpe_field": "perceived_effort_rpe",
    "rpe_scale": "0_to_10",
    "duration_field": "duration_seconds",
    "formula_per_activity": "perceived_effort_rpe * duration_seconds / 60",
    "daily_aggregation": "sum_over_all_activities",
    "valid_rpe_minimum": 0,
    "valid_rpe_maximum": 10,
    "duration_must_be_positive": true,
    "missing_values_remain_null": true
  },
  "load_model_limitations": [
    "session-RPE and active kilocalories are different proxy units; every selected daily source is retained for audit.",
    "The fallback prevents missing RPE from becoming zero load but does not make both proxies physiologically equivalent.",
    "This model is not TRIMP.",
    "This model is not a medical diagnosis or professional coaching prescription."
  ],
  "date_axis_policy": {
    "date_field": "date",
    "date_format": "YYYY-MM-DD",
    "window_unit": "calendar_days",
    "missing_calendar_dates_policy": "do_not_impute_and_do_not_assume_zero",
    "duplicate_dates_policy": "fail"
  },
  "rolling_load_metrics": {
    "acute_rolling_7d": {"window_days": 7, "formula": "mean(load_value over current calendar day and previous 6 calendar days)", "minimum_required_valid_days": 7, "require_complete_calendar_window": true},
    "chronic_rolling_28d": {"window_days": 28, "formula": "mean(load_value over current calendar day and previous 27 calendar days)", "minimum_required_valid_days": 28, "require_complete_calendar_window": true},
    "acwr_rolling": {"formula": "acute_rolling_7d / chronic_rolling_28d", "require_positive_chronic_load": true}
  },
  "ewma_load_metrics": {
    "acute_ewma": {"days": 7, "alpha_formula": "2 / (days + 1)", "alpha": 0.25, "formula": "result[0] = load[0]; result[i] = alpha * load[i] + (1 - alpha) * result[i-1]"},
    "chronic_ewma": {"days": 28, "alpha_formula": "2 / (days + 1)", "alpha": 0.06896551724137931, "formula": "result[0] = load[0]; result[i] = alpha * load[i] + (1 - alpha) * result[i-1]"},
    "acwr_ewma": {"formula": "acute_ewma / chronic_ewma", "require_positive_chronic_load": true},
    "initialization_policy": "initialize_only_at_first_record_of_a_contiguous_valid_sequence",
    "gap_policy": "restart_ewma_sequence_after_missing_calendar_day_or_invalid_load_value"
  },
  "weekly_variability_metrics": {
    "monotony_7d": {"window_days": 7, "formula": "mean(load_value_window) / population_standard_deviation(load_value_window)", "minimum_required_valid_days": 7, "require_complete_calendar_window": true, "zero_standard_deviation_policy": "null_and_warning"},
    "strain_7d": {"window_days": 7, "formula": "sum(load_value_window) * monotony_7d", "requires_monotony": true}
  },
  "acwr_zones": [
    {"zone_id": "underload", "label": "niedobor", "condition": "value < 0.8"},
    {"zone_id": "optimal", "label": "optimum", "condition": "0.8 <= value <= 1.3"},
    {"zone_id": "caution", "label": "ostroznie", "condition": "1.3 < value <= 1.5"},
    {"zone_id": "risk", "label": "ryzyko", "condition": "value > 1.5"}
  ],
  "missing_values_policy": {"missing_daily_load": "do_not_compute_affected_metrics_and_report_coverage", "missing_calendar_date": "do_not_fill_with_zero", "unavailable_metric_output": null},
  "output_rounding": {"internal_calculations": "full_precision", "serialized_decimal_places": 6},
  "prohibited_calculations": ["rhr_delta", "ln_rmssd", "readiness", "LQ", "REC", "CAP", "VS", "pws_weights", "pws_score", "pws_priority", "llm_adjustments"],
  "notes": [
    "Rolling ACWR and EWMA ACWR are separate metrics and must not be conflated.",
    "Rolling windows use calendar days, not merely the last N available records.",
    "Missing daily data must never silently become zero training load.",
    "ACWR zones are descriptive product labels, not medical or injury diagnoses."
  ]
}
