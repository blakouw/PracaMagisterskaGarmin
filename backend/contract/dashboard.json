{
  "module_id": "18_angular_dashboard_ui",
  "module_name": "Local Dashboard UI",
  "version": "1.0.0",
  "status": "implemented",
  "optional": false,
  "responsibility": "Builds a local dashboard UI and local LLM conversation panel consuming only the local dashboard API, presenting deterministic PWS as the primary score and comparing deterministic, local-LLM and external-OpenAI PWS series without recomputing or modifying analytical data.",
  "depends_on": [
    "00_project_contract",
    "17_local_api_server"
  ],
  "optional_inputs_from": [],
  "inputs": [
    "config/local_dashboard_ui_policy_v1.json",
    "config/dashboard_snapshot_api_policy_v1.json",
    "data/pipeline/17_local_api_server/api_contract_schema.json",
    "data/pipeline/17_local_api_server/api_quality_report.json",
    "GET /api/v1/health",
    "GET /api/v1/snapshot/status",
    "GET /api/v1/dashboard/current-state",
    "GET /api/v1/dashboard/time-series",
    "GET /api/v1/dashboard/quality",
    "GET /api/v1/dashboard/disclosures",
    "POST /api/v1/dashboard/chat"
  ],
  "outputs": [
    "pipeline/18_angular_dashboard_ui/app/",
    "pipeline/18_angular_dashboard_ui/ui_contract_schema.json",
    "data/pipeline/18_angular_dashboard_ui/ui_validation_report.json",
    "data/pipeline/18_angular_dashboard_ui/ui_build_manifest.json",
    "data/pipeline/18_angular_dashboard_ui/ui_quality_report.json",
    "data/pipeline/18_angular_dashboard_ui/ui_lineage.json",
    "data/pipeline/18_angular_dashboard_ui/run_manifest.json",
    "data/pipeline/18_angular_dashboard_ui/run_log.txt",
    "data/pipeline/18_angular_dashboard_ui/errors.json"
  ],
  "runtime": {
    "type": "local_web_frontend",
    "frontend_default_host": "127.0.0.1",
    "frontend_default_port": 5173,
    "api_proxy_target": "http://127.0.0.1:8765",
    "local_only": true,
    "read_only": true,
    "public_exposure_approved": false,
    "local_llm_chat_via_api": true,
    "browser_direct_llm_calls": false
  },
  "run_command": "pipeline/18_angular_dashboard_ui/run.bat",
  "build_command": "pipeline/18_angular_dashboard_ui/build.bat",
  "artifact_directory": "data/pipeline/18_angular_dashboard_ui",
  "test_directory": "tests/18_angular_dashboard_ui",
  "visualization_directory": "visualization/18_angular_dashboard_ui",
  "prohibited_responsibilities": [
    "read_pipeline_files_directly_from_browser",
    "read_published_snapshot_files_directly_from_browser",
    "recompute_load_metrics",
    "recompute_readiness",
    "recompute_pws_components",
    "recompute_pws_weights",
    "recompute_pws_deterministic",
    "recompute_pws_llm_assisted",
    "trigger_pipeline",
    "modify_snapshot",
    "implement_write_api",
    "implement_authentication",
    "implement_user_profile",
    "implement_garmin_token_pipeline",
    "generate_coaching_message",
    "generate_medical_diagnosis",
    "predict_injury",
    "generate_training_prescription",
    "implement_public_deployment",
    "depend_on_previous_project_runtime",
    "call_llm_directly_from_browser",
    "call_llm_for_recomputing_scores"
  ],
  "data_sensitivity": "private_locally_displayed_derived_health_activity_training_and_wellness_presentation_data",
  "notes": [
    "The UI consumes only the local read-only API.",
    "Deterministic PWS is always the primary score.",
    "Optional assisted PWS may be displayed only as a separately labelled comparison variant.",
    "The model comparison panel presents deterministic, local-LLM and external-OpenAI series from the API and preserves missing values as unavailable.",
    "The UI is local-only and not approved for public deployment.",
    "The UI does not implement authentication, Garmin token management, pipeline execution or analytical calculations.",
    "The chat panel talks only to the local API chat endpoint and does not call the LLM provider directly from the browser.",
    "Daily signal charts and component input-variable charts consume only fields exposed by the local API time-series payload."
  ]
}
