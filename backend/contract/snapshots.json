{
  "module_id": "16_persist_local_snapshot",
  "module_name": "Persist Local Snapshot",
  "version": "1.0.0",
  "status": "implemented",
  "optional": false,
  "responsibility": "Publishes immutable local snapshots and an atomically replaceable current copy of an existing dashboard presentation payload for future API or UI consumption, without recomputing analytical values or modifying deterministic or optional assisted PWS.",
  "depends_on": [
    "00_project_contract",
    "15_build_dashboard_payload"
  ],
  "optional_inputs_from": [],
  "inputs": [
    "config/dashboard_snapshot_policy_v1.json",
    "config/dashboard_payload_policy_v1.json",
    "data/pipeline/15_build_dashboard_payload/dashboard_payload.json",
    "data/pipeline/15_build_dashboard_payload/dashboard_time_series.csv",
    "data/pipeline/15_build_dashboard_payload/dashboard_payload_schema.json",
    "data/pipeline/15_build_dashboard_payload/dashboard_payload_quality_report.json",
    "data/pipeline/15_build_dashboard_payload/dashboard_payload_lineage.json",
    "optional: data/pipeline/15_build_dashboard_payload/dashboard_time_series.parquet"
  ],
  "outputs": [
    "data/pipeline/16_persist_local_snapshot/snapshot_publication.json",
    "data/pipeline/16_persist_local_snapshot/snapshot_publication_schema.json",
    "data/pipeline/16_persist_local_snapshot/snapshot_publication_quality_report.json",
    "data/pipeline/16_persist_local_snapshot/snapshot_publication_lineage.json",
    "data/pipeline/16_persist_local_snapshot/run_manifest.json",
    "data/pipeline/16_persist_local_snapshot/run_log.txt",
    "data/pipeline/16_persist_local_snapshot/errors.json",
    "data/published/dashboard_snapshots/history/<snapshot_id>/dashboard_payload.json",
    "data/published/dashboard_snapshots/history/<snapshot_id>/dashboard_time_series.csv",
    "data/published/dashboard_snapshots/history/<snapshot_id>/snapshot_manifest.json",
    "data/published/dashboard_snapshots/history/<snapshot_id>/snapshot_source_hashes.json",
    "data/published/dashboard_snapshots/history/<snapshot_id>/snapshot_status.json",
    "data/published/dashboard_snapshots/current/dashboard_payload.json",
    "data/published/dashboard_snapshots/current/dashboard_time_series.csv",
    "data/published/dashboard_snapshots/current/snapshot_manifest.json",
    "data/published/dashboard_snapshots/current/snapshot_source_hashes.json",
    "data/published/dashboard_snapshots/current/snapshot_status.json"
  ],
  "run_command": "pipeline/16_persist_local_snapshot/run.bat",
  "artifact_directory": "data/pipeline/16_persist_local_snapshot",
  "published_snapshot_root": "data/published/dashboard_snapshots",
  "test_directory": "tests/16_persist_local_snapshot",
  "visualization_directory": "visualization/16_persist_local_snapshot",
  "prohibited_responsibilities": [
    "recompute_load_metrics",
    "recompute_readiness",
    "recompute_pws_components",
    "recompute_pws_weights",
    "recompute_pws_deterministic",
    "recompute_pws_llm_assisted",
    "call_llm",
    "generate_coaching_message",
    "generate_medical_diagnosis",
    "predict_injury",
    "generate_training_prescription",
    "implement_api_server",
    "implement_http_routes",
    "implement_authentication",
    "implement_user_profile",
    "implement_user_interface",
    "implement_garmin_token_pipeline",
    "delete_snapshot_history_automatically",
    "depend_on_previous_project_runtime"
  ],
  "data_sensitivity": "private_published_derived_health_activity_training_and_wellness_presentation_data",
  "notes": [
    "The snapshot module publishes copies of existing dashboard artifacts only.",
    "Historical snapshots are immutable and are not automatically deleted.",
    "The current snapshot is replaced only after a complete validated staged copy exists.",
    "Deterministic PWS remains primary and optional assisted PWS remains a separately labelled variant.",
    "Published snapshots are private local artifacts and must not be committed to version control."
  ]
}
