{
  "module_id": "19_packaging_windows",
  "module_name": "Packaging Windows",
  "version": "1.0.0",
  "status": "implemented",
  "optional": false,
  "responsibility": "Builds a local portable Windows bundle for the already implemented dashboard application by compiling the UI to production static assets, packaging a single localhost read-only runtime executable for /api/v1 and the UI, and producing release manifests and a ZIP without private snapshots, Garmin exports, tokens, secrets, pipeline execution, LLM calls or public exposure.",
  "depends_on": [
    "00_project_contract",
    "17_local_api_server",
    "18_angular_dashboard_ui"
  ],
  "optional_inputs_from": [],
  "inputs": [
    "config/windows_packaging_policy_v1.json",
    "config/dashboard_snapshot_api_policy_v1.json",
    "config/dashboard_snapshot_policy_v1.json",
    "config/local_dashboard_ui_policy_v1.json",
    "pipeline/17_local_api_server/api_app.py",
    "pipeline/17_local_api_server/contract.json",
    "data/pipeline/17_local_api_server/api_contract_schema.json",
    "data/pipeline/17_local_api_server/api_quality_report.json",
    "pipeline/18_angular_dashboard_ui/app/",
    "pipeline/18_angular_dashboard_ui/build.bat",
    "pipeline/18_angular_dashboard_ui/contract.json",
    "pipeline/18_angular_dashboard_ui/ui_contract_schema.json",
    "data/pipeline/18_angular_dashboard_ui/ui_build_manifest.json",
    "data/pipeline/18_angular_dashboard_ui/ui_quality_report.json"
  ],
  "outputs": [
    "data/pipeline/19_packaging_windows/windows_package_manifest.json",
    "data/pipeline/19_packaging_windows/windows_package_integrity.json",
    "data/pipeline/19_packaging_windows/windows_package_privacy_audit.json",
    "data/pipeline/19_packaging_windows/windows_package_quality_report.json",
    "data/pipeline/19_packaging_windows/windows_package_lineage.json",
    "data/pipeline/19_packaging_windows/run_manifest.json",
    "data/pipeline/19_packaging_windows/run_log.txt",
    "data/pipeline/19_packaging_windows/errors.json",
    "release/windows/PersonalWellnessDashboard_1.0.0_portable/",
    "release/windows/PersonalWellnessDashboard_1.0.0_portable.zip"
  ],
  "runtime": {
    "type": "portable_windows_localhost_bundle",
    "executable_name": "PersonalWellnessDashboard.exe",
    "host": "127.0.0.1",
    "port": 8765,
    "local_only": true,
    "read_only": true,
    "public_exposure_approved": false,
    "uses_vite_dev_server": false,
    "serves_static_ui_assets": true,
    "serves_api_v1": true,
    "packages_private_data": false
  },
  "run_command": "pipeline/19_packaging_windows/run.bat",
  "artifact_directory": "data/pipeline/19_packaging_windows",
  "test_directory": "tests/19_packaging_windows",
  "visualization_directory": "visualization/19_packaging_windows",
  "prohibited_responsibilities": [
    "create_installer",
    "auto_update_application",
    "public_deployment",
    "lan_exposure",
    "implement_authentication",
    "implement_user_profile",
    "implement_garmin_token_pipeline",
    "run_full_pipeline",
    "sync_garmin_data",
    "call_llm",
    "generate_coaching_message",
    "generate_medical_diagnosis",
    "predict_injury",
    "generate_training_prescription",
    "package_private_snapshots",
    "package_tokens_or_secrets",
    "depend_on_previous_project_runtime"
  ],
  "data_sensitivity": "public_packaging_configuration_and_local_release_metadata_without_private_dashboard_data",
  "notes": [
    "The package is a local portable runtime for an already published current snapshot supplied by the user outside the binary.",
    "The frontend is packaged from the production build output and does not use the Vite development server at runtime.",
    "The package starts only a localhost process on 127.0.0.1:8765.",
    "The package does not include private snapshots, Garmin exports, tokens or secrets.",
    "The package does not run Garmin ingest, the analytical pipeline, LLM calls, authentication or public deployment."
  ]
}
